class Solution {
public:

    void solve( vector < int > & nums , int idx , int xr , int & ans){

        if ( idx == nums.size()){
            ans += xr ;
            return ;
        }
        solve ( nums , idx + 1 , xr ^ nums[idx] , ans);
        solve ( nums , idx + 1 , xr , ans );
    }
    int subsetXORSum(vector<int>& nums) {
        int ans = 0  ;
        int xr ;
        int idx ;
        solve ( nums , 0 , 0 , ans);
        return ans;
        
    }
};
