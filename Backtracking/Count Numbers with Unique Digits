class Solution {
public:
    int countNumbersWithUniqueDigits(int n) {
        if(n==0) return 1;
        int a = 10 ;
        int b = 9;
        int c  = 9 ;
        for(int i = 2; i <= n && c > 0 ; i++){
            b = b * c ;
            a = a + b ;
            c--;
        }

        return a;
    }
};
