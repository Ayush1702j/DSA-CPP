class Solution {
public:
    void solve ( int k , int n , int st , vector < int > & arr ,vector < vector < int >> & ans ){
        if ( arr.size() == k ){
            int sum = 0 ;
            for ( int i = 0 ; i < arr.size(); i++){
                sum += arr[i] ;
            }
            if ( sum == n){
                ans.push_back(arr);
            }
            return ;
        }

        for ( int i = st ; i <= 9 ; i++ ){

            arr.push_back(i);
            solve( k , n , i + 1 , arr , ans );
            arr.pop_back();
        }
            
    }
    vector<vector<int>> combinationSum3(int k, int n) {
        int st ;
        vector < int > arr ;
        vector < vector <int >> ans ;

        solve ( k , n , 1 , arr , ans);
        return ans ;
    }
};
