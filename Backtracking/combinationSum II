class Solution {
public:

    void solve ( vector < int > & candidates , int target , int st , vector < int > & arr ,  vector < vector < int >> & ans){

        if ( target == 0 ) {
            ans.push_back( arr );
            return ;
        }
        if ( target < 0 ){
            return ;
        }

        for ( int i = st ; i < candidates.size() ; i++){
            if ( i > st && candidates[i] == candidates[i-1]){
                continue;
            }

            arr.push_back(candidates[i]);
            solve(candidates, target - candidates[i], i + 1, arr, ans);
            arr.pop_back();
        }
    }
    vector<vector<int>> combinationSum2(vector<int>& candidates, int target) {
        sort(candidates.begin(), candidates.end());
        int st ;
        vector < int > arr ;
        vector < vector < int > > ans ;
        solve ( candidates , target , 0 , arr ,ans );
        return ans ;
    }
};
