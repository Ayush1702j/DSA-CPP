class Solution {
public:

    void backtrack( int n , int open , int close , string & ans , vector < string > & result){

        if ( ans.size() == n * 2){
            result.push_back(ans);
            return ;
        }

        if ( open < n ){
            ans.push_back('(');
            backtrack(n,open+1,close,ans,result);
            ans.pop_back();
        }

        if(close < open ){
            ans.push_back(')');
            backtrack(n,open,close+1,ans,result);
            ans.pop_back();
        }

    }
    vector<string> generateParenthesis(int n) {
        string ans;
        vector<string> result ;

        backtrack(n,0,0,ans,result);

        return result ;
    }
};
