class Solution {
public:

    void solve ( vector <int > & nums , int idx , vector < int > & arr , vector < vector < int > > & ans ){

        if ( idx == nums.size()){
            ans.push_back(arr);
            return ;
        }

        arr.push_back( nums[idx]);
        solve ( nums , idx + 1 , arr , ans );
        arr.pop_back();
        solve( nums , idx + 1 , arr , ans );
    } 
    vector<vector<int>> subsets(vector<int>& nums) {
        vector < int > arr ;
        vector < vector < int > > ans ;
        int idx ;

        solve ( nums , 0 , arr , ans );
        return ans ;
    }
};
