class Solution {
public:
    void inorder( TreeNode * root , vector < int > & ans){
        if( root == NULL){
            return ;
        }
        inorder( root -> left , ans);
        ans.push_back(root -> val);
        inorder( root -> right,ans);
    }
    bool findTarget(TreeNode* root, int k) {
        vector < int > a;
        inorder ( root , a);

        int ans = 0 ;
        int left = 0 ;
        int right = a.size() -1 ;

        while ( left < right ){
            int sum = a[left] + a[right];

            if (k == sum){
                return true ;
            }
            else if ( sum < k ){
                left ++ ;
            }
            else {
                right -- ;
            }
        }

        return false ;

    }
};
