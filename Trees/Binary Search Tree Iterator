class BSTIterator {
public:
    vector < int > ans ;
    int index = 0 ;

    void inorder ( TreeNode * root ){
        if ( root == NULL ) {
            return ;
        }

        inorder ( root -> left );
        ans.push_back( root -> val );
        inorder( root -> right );
    }

    BSTIterator(TreeNode* root) {
        inorder (root);
    }
    
    int next() {
        return ans[index++];
    }
    
    bool hasNext() {
        return index < ans.size();
    }
};
