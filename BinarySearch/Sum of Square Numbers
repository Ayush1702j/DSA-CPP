class Solution {
public:
    bool judgeSquareSum(int c) {
        long long left = 0 ;
        long long right = sqrt(c);

        while(left <= right  ){
            long long a = left*left + right * right ;
            if(a == c){
                return true ;
            }
            else if(a < c){
                left ++ ;
            }
            else {
                right -- ;
            }
        }
        return false ;
    }
};
