class Solution {
public:
    vector<int> asteroidCollision(vector<int>& asteroids) {
        
        stack < int > st ;
    
        for ( int i = 0 ; i < asteroids.size() ; i++ ){
            int as = asteroids[i];
            bool ds = false ;

            while ( !st.empty() && st.top() > 0 && as < 0){
                if ( st.top() < abs(as)){
                    st.pop();
                }
                else if ( st.top() == abs(as)){
                    st.pop();
                    ds = true ;
                    break ;
                }
                else {
                    ds = true ;
                    break ;
                }

            }

            if( !ds ){
                st.push(as);
            }
        }
        vector < int > ans ( st.size()) ;

        for ( int i = st.size() -1 ; i >= 0 ; i--){
            ans[i] = st.top();
            st.pop();
        }

        return ans ;

    }
};
