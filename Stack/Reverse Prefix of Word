class Solution {
public:
    string reversePrefix(string word, char ch) {
        stack < char > st ;
        string ans = "";
        int x = 0 ;
        for ( int i = 0 ; i < word.size() ; i++){
            if( word[i] == ch){
                x = i ;
                break ;
            }
        }

        for ( int i = 0 ; i < x+1 ; i++){
            st.push(word[i]);
        }

        while ( !st.empty()){
            ans += st.top();
            st.pop();
        }

        for ( int i = x + 1 ; i < word.size() ; i++){
            ans += word[i];
        }

        return ans ;
    }
};
