class Solution {
public:
    int minLength(string s) {
       stack < char > st ;

       if ( s.size() == 1) return 1 ;
       if( s.size() == 0) return 0 ;
       for ( int i = 0 ; i < s.size() ; i++){
            if ( !st.empty() && ((s[i]  == 'B' && st.top() == 'A') || ( s[i] == 'D' && st.top() == 'C'))){
                st.pop();
            }
            else {
                st.push(s[i]);
            }
       } 

       string ans = "";

       while ( !st.empty()){
        ans += st.top();
        st.pop();
       }

       return ( ans.size());
    }
};
