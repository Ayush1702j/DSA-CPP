class Solution {
public:
    int countStudents(vector<int>& students, vector<int>& sandwiches) {
        int zero = 0 ;
        int one = 0 ;

        for ( auto x : students){
            if( x == 0){
                zero ++ ;
            }
            else one ++ ;
        }

        for ( auto x : sandwiches){
            if( x == 0){
                if( zero == 0){
                    return one ;
                }
                zero -- ;
            }
            else {
               if( one == 0){
                return zero ;
               }
               one -- ;
            }

        }
        return 0 ;
    }
};
