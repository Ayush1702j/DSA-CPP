class Solution {
public:
    int myAtoi(string s) {
        long long ans = 0 ;
        int sign = 1 ;
        int i = 0 ;

        while ( i < s.size() && s[i] == ' '){
            i++;
        }

        if ( i < s.size() && s[i] == '-'){
            sign = -1 ;
            i++;
        }
        else if ( i < s.size() && s[i] == '+'){
            i++;
        }

        while ( i < s.size() && isdigit(s[i])){
            int digits = s[i] - '0';

            ans = ans * 10 + digits ;

            if( ans * sign > INT_MAX){
                return INT_MAX ;
            }
            if ( ans * sign < INT_MIN) return INT_MIN ;
            i++;
        }
        return ans * sign ;
    }
};
