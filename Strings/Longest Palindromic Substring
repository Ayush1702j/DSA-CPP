class Solution {
public:

    bool A ( string & s , int l , int r ){
        while ( l < r ){
            if (s[l] != s[r]){
                return false ;
            }
            l++;
            r--;
        }
        return true  ;
    }
    string longestPalindrome(string s) {
        int n = s.size();
        int start = 0 ;
        int maxlen = 1 ;

        for ( int i = 0 ; i < n ; i++){
            for ( int j = i ; j < n ; j++){
                if ( A (s,i,j)){
                    int len = j - i + 1 ;

                    if( len > maxlen){
                        maxlen = len ;
                        start = i ;
                    }
                }
            }
        }

        string ans = "";
        for ( int i = start ; i < start + maxlen ; i++){
            ans += s[i];
        }

        return ans ;
    }
};
