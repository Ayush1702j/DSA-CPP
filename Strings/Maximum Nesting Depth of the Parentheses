class Solution {
public:
    int maxDepth(string s) {
        int ans = 0 ;
        int dept = 0 ;
        for(char c : s){
            if(c == '('){
                dept ++ ;
                ans = max(ans,dept);
            }
            else if ( c == ')'){
                dept -- ;
            }
        }
        return ans ;
    }
};
