class Solution {
public:
    int findDuplicate(vector<int>& nums) {
        unordered_map < int , int > mp ;

        int ans = 0 ;

        for(auto x : nums){
            mp[x] ++ ;
        }

        for(auto x : mp){
            if(x.second > 1 ){
                ans = x.first ;
            }
        }
        return ans ;
    }
};
