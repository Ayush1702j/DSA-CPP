class Solution {
public:
    vector<int> sortArrayByParityII(vector<int>& nums) {
        vector<int> ans;
        vector<int> res ;

        for(int i = 0 ; i < nums.size() ; i++){
            if( nums[i] % 2 == 0){
                ans.push_back(nums[i]);
            }
            else{
                res.push_back(nums[i]);
            }
        }
        vector<int> result ;

        for(int i = 0 ; i < ans.size(); i++){
            result.push_back(ans[i]);
            result.push_back(res[i]);
        }

        return result ;

        
    }
};
