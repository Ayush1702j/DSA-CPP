class Solution {
public:
    vector<int> leftRightDifference(vector<int>& nums) {
        vector < int > left ;
        vector < int > right ;
        int a = 0  ;
        for ( int i = 0 ; i < nums.size() ; i++){
            if ( i > 0 ){
                 a =  a + nums[i-1];
                left.push_back(a);
            }
            else{
                left.push_back(a);
            }
        }
        
        int b = 0 ;
        int sum = 0 ;
        for ( auto x : nums){
            sum += x ;
        }

        for ( int i = 0 ; i < nums.size() ; i++){

            if ( i != nums.size() -1 ){
                sum = sum - nums[i];
                right.push_back(sum);
            }
            else {
                right.push_back(b);
            }
        }

       vector < int > ans ;
       for ( int i = 0 ; i < nums.size() ; i++){
        int s = abs ( left[i] - right[i]);
        ans.push_back(s);
       }

       return ans ;
        
    }
};
